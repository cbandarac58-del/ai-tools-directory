---
import Layout from '../../layouts/Layout.astro';
import ToolCard from '../../components/ToolCard.astro';
import AdPlacement from '../../components/AdPlacement.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const allTools = await getCollection('tools');
  
  // Extract unique categories and map them to lowercase URL params
  const categories = Array.from(new Set(allTools.map(t => t.data.category.toLowerCase())));
  
  return categories.map((cat) => {
    // Find the original cased category name
    const originalCategoryName = allTools.find(t => t.data.category.toLowerCase() === cat)?.data.category || cat;
    
    return {
      params: { category: cat },
      props: { 
        categoryName: originalCategoryName,
        tools: allTools.filter(t => t.data.category.toLowerCase() === cat)
      }
    };
  });
}

const { category } = Astro.params;
const { categoryName, tools } = Astro.props;

// Sort tools by dateAdded descending
const sortedTools = [...tools].sort((a, b) => 
  new Date(b.data.dateAdded).getTime() - new Date(a.data.dateAdded).getTime()
);

const pageTitle = `Best AI ${categoryName} Tools & Directory`;
const pageDescription = `Discover the top-rated AI tools in the ${categoryName} category. Browse verified reviews, features, specs, pricing, and compare modern software.`;
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- Hero / Header -->
  <section class="relative overflow-hidden pt-16 pb-12 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-indigo-900/10 via-[#0b0f19] to-[#0b0f19] border-b border-slate-900">
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-80 h-80 bg-indigo-500/5 rounded-full blur-3xl -z-10"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex text-sm text-slate-500 mb-4 font-medium justify-center sm:justify-start">
        <a href="/" class="hover:text-indigo-400">Home</a>
        <span class="mx-2">&gt;</span>
        <span class="text-slate-300">Category: {categoryName}</span>
      </nav>

      <div class="text-center sm:text-left space-y-4">
        <h1 class="font-outfit font-extrabold text-3xl sm:text-5xl tracking-tight text-white leading-none">
          AI Tools in <span class="bg-gradient-to-r from-indigo-400 to-purple-400 bg-clip-text text-transparent">{categoryName}</span>
        </h1>
        <p class="text-sm sm:text-base text-slate-400 max-w-xl font-light leading-relaxed">
          Explore our collection of handpicked, expert-reviewed AI-powered tools and platforms specialized in {categoryName.toLowerCase()}. Compare pricing, capabilities, pros, and cons.
        </p>
      </div>
    </div>
  </section>

  <!-- Top Ad Placement -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <AdPlacement type="top-banner" />
  </div>

  <!-- Listings Grid Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex flex-col md:flex-row gap-8">
      
      <!-- Main Content Area -->
      <div class="flex-grow">
        <div class="flex items-center justify-between mb-8 border-b border-slate-800/40 pb-4">
          <h2 class="text-lg font-bold font-outfit text-white">Top Recommendations</h2>
          <span class="text-xs text-slate-400">{sortedTools.length} tools found</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {sortedTools.map((tool) => (
            <ToolCard tool={{
              title: tool.data.title,
              slug: tool.data.slug,
              description: tool.data.description,
              category: tool.data.category,
              subCategory: tool.data.subCategory,
              pricingType: tool.data.pricingType,
              tags: tool.data.tags,
              image: tool.data.image
            }} />
          ))}
        </div>
      </div>

      <!-- Right Sidebar (For Ads & Curation Details) -->
      <aside class="w-full md:w-[300px] shrink-0">
        <div class="sticky top-20 space-y-6">
          <!-- Sidebar Ad Placeholders -->
          <AdPlacement type="sidebar" />
          
          <!-- Curation Note -->
          <div class="bg-slate-900/20 border border-slate-800/60 rounded-2xl p-5">
            <h3 class="font-outfit font-bold text-white text-base mb-3">Directory Policy</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Our review team rates tools based on UX design, API speed, output quality, pricing transparency, and feature richness.
            </p>
            <p class="text-xs text-slate-500 mt-2">
              Have a tool in {categoryName} you would like us to review? Reach out via our <a href="/contact" class="text-indigo-400 hover:underline">Contact</a> page.
            </p>
          </div>
        </div>
      </aside>
      
    </div>
  </section>
</Layout>
