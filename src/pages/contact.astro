---
import Layout from '../layouts/Layout.astro';
import AdPlacement from '../components/AdPlacement.astro';

const pageTitle = "Contact Us - AIPioneerHub Tool Inquiries";
const pageDescription = "Get in touch with the AIPioneerHub editorial team. Submit an AI tool for review, report directory errors, or discuss partnership opportunities.";
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumbs -->
    <nav class="flex text-sm text-slate-500 mb-6 font-medium">
      <a href="/" class="hover:text-indigo-400">Home</a>
      <span class="mx-2">&gt;</span>
      <span class="text-slate-300">Contact Us</span>
    </nav>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      
      <!-- Contact Info Sidebar -->
      <div class="space-y-6">
        <h1 class="font-outfit font-extrabold text-3xl sm:text-4xl text-white leading-none">
          Contact <span class="bg-gradient-to-r from-indigo-400 to-purple-400 bg-clip-text text-transparent">Us</span>
        </h1>
        <p class="text-sm text-slate-400 leading-relaxed font-light">
          Have an AI tool you want to suggest? Found a bug, or want to discuss commercial partnerships? We'd love to hear from you.
        </p>

        <div class="bg-slate-900/20 border border-slate-800/60 rounded-2xl p-5 space-y-4">
          <h3 class="font-outfit font-bold text-white text-base">Direct Email</h3>
          <p class="text-xs text-slate-400 leading-normal">
            For fastest response, reach out to our marketing and support inbox directly:
          </p>
          <a 
            id="contact-email-link"
            href="mailto:brazilmarketing1@gmail.com" 
            class="inline-flex items-center gap-2 text-sm font-semibold text-indigo-400 hover:text-indigo-300 transition-colors break-all"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            brazilmarketing1@gmail.com
          </a>
        </div>

        <AdPlacement type="sidebar" />
      </div>

      <!-- Contact Form Area -->
      <div class="md:col-span-2 bg-slate-900/10 border border-slate-850 rounded-3xl p-6 sm:p-8 space-y-6">
        <h2 class="text-xl font-bold font-outfit text-white">Send Us a Message</h2>
        
        <form class="space-y-4" onsubmit="event.preventDefault(); alert('Thank you for reaching out! We will review your message and respond shortly.');">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="contact-name" class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Your Name</label>
              <input 
                type="text" 
                id="contact-name" 
                name="name" 
                required 
                placeholder="John Doe" 
                class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-slate-100 placeholder-slate-600 focus:outline-none focus:border-indigo-500 transition-colors"
              />
            </div>
            <div>
              <label for="contact-email" class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Email Address</label>
              <input 
                type="email" 
                id="contact-email" 
                name="email" 
                required 
                placeholder="john@example.com" 
                class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-slate-100 placeholder-slate-600 focus:outline-none focus:border-indigo-500 transition-colors"
              />
            </div>
          </div>
          
          <div>
            <label for="contact-subject" class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Subject</label>
            <input 
              type="text" 
              id="contact-subject" 
              name="subject" 
              required 
              placeholder="e.g. AI Tool Submission" 
              class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-slate-100 placeholder-slate-600 focus:outline-none focus:border-indigo-500 transition-colors"
            />
          </div>
          
          <div>
            <label for="contact-message" class="block text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Message</label>
            <textarea 
              id="contact-message" 
              name="message" 
              required 
              rows="5" 
              placeholder="Tell us about your tool or partnership proposal..." 
              class="w-full bg-slate-950 border border-slate-800 rounded-xl px-4 py-3 text-sm text-slate-100 placeholder-slate-600 focus:outline-none focus:border-indigo-500 transition-colors resize-none"
            ></textarea>
          </div>
          
          <button 
            type="submit" 
            id="contact-submit-btn"
            class="w-full py-4 px-6 bg-indigo-600 hover:bg-indigo-500 text-white font-semibold rounded-xl text-sm transition-colors shadow-md shadow-indigo-600/10 hover:shadow-indigo-500/20"
          >
            Send Message
          </button>
        </form>
      </div>

    </div>
  </div>
</Layout>
